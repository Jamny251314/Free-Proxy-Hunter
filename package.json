{
  "name": "proxy-hunter-agent",
  "version": "1.0.0",
  "type": "module",
  "description": "全网免费代理猎手 —— 基于 CodeBuddy Agent SDK 的免费 IP 代理采集 / 测速 / Clash Verge 一体化 Web Agent",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "server": "tsx server/index.ts",
    "proxy:fetch": "tsx server/cli.ts fetch",
    "proxy:test": "tsx server/cli.ts test",
    "proxy:sync": "tsx server/cli.ts sync",
    "proxy:export": "tsx server/cli.ts export",
    "proxy:stats": "tsx server/cli.ts stats",
    "proxy:sources": "tsx server/cli.ts sources",
    "proxy:selftest": "tsx server/selftest.ts"
  },
  "dependencies": {
    "@tdesign-react/aigc": "^0.1.0-alpha.1",
    "@tdesign-react/chat": "^1.0.2",
    "@tencent-ai/agent-sdk": "^0.3.43",
    "express": "^4.18.2",
    "lucide-react": "^0.563.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.0",
    "tdesign-icons-react": "^0.5.0",
    "tdesign-react": "^1.12.0",
    "tsx": "^4.6.2",
    "uuid": "^9.0.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "less": "^4.3.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.3.2",
    "vite": "^6.0.0"
  }
}
